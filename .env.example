# String de ligação do Neon (sem &channel_binding=require)
DATABASE_URL=postgresql://UTILIZADOR:SENHA@HOST/moztele?sslmode=require
# Frase longa e aleatória (assina as sessões)
AUTH_SECRET=troque-por-uma-frase-longa-e-aleatoria
# Vercel Blob (ficheiros). Deixe vazio em desenvolvimento local.
BLOB_READ_WRITE_TOKEN=

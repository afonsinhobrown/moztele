# String de ligação do Neon
DATABASE_URL=postgresql://UTILIZADOR:SENHA@HOST/moztele?sslmode=require
# Frase longa e aleatória (mínimo 24 caracteres). Assina as sessões.
AUTH_SECRET=troque-por-uma-frase-longa-e-aleatoria

# Cloudflare R2 (ficheiros: comprovativos e orçamentos)
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto

# Alternativa antiga: Vercel Blob (só usada se as OBJECT_STORAGE_* estiverem vazias)
BLOB_READ_WRITE_TOKEN=

# Avisos por WhatsApp (Meta Cloud API). Opcional.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Template aprovado na Meta para avisos proactivos (texto livre só entrega
# dentro da janela de 24 h). O template deve ter uma variável no corpo: {{1}}.
WHATSAPP_TEMPLATE_ALERTA=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# Avisos por email (Resend). Opcional: sem chave, ficam só na app.
RESEND_API_KEY=
EMAIL_FROM=Moz Teles <avisos@exemplo.co.mz>

# Avisos por SMS (gateway HTTP genérico). Opcional.
# POST {"to": "...", "message": "..."} com Authorization: Bearer <token>.
SMS_URL=
SMS_TOKEN=

# Mostrar as contas de teste na página de login (false esconde a lista)
MOSTRAR_CREDENCIAIS_TESTE=true
